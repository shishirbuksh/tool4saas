    "preview": "astro preview",
    "start": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "adsense:check": "node scripts/check-adsense-readiness.mjs",
    "verify:build": "node scripts/verify-dist.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs"
  },
