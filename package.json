  "private": true,
  "description": "Productivity toolkit — free online tools for invoices, QR codes, resumes and text utilities. Monetized with display ads.",
  "scripts": {
    "dev": "node scripts/generate-view-registry.mjs && astro dev",
    "build": "node scripts/validate-tools.mjs && node scripts/validate-blog.mjs && node scripts/generate-catalog-lite.mjs && node scripts/generate-edit-dates.mjs && node scripts/generate-llms.mjs && node scripts/generate-nginx.mjs && node scripts/generate-view-registry.mjs && astro build",
