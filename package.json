    "@mui/material": "^9.4.0",
    "astro": "^7.4.4",
    "fflate": "^0.8.3",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "oxc-transform-react": "^0.145.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
