{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@mui/material/*": ["./src/components/ds/*"],
      "@mui/material": ["./src/components/ds/index"],
      "@mui/icons-material/*": ["./src/components/ds/icons/*"],
      "@mui/icons-material": ["./src/components/ds/icons/index"]
    },
    "verbatimModuleSyntax": false,
    "types": ["vite/client"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".next", "out"]
}
