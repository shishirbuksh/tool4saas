NEXT_PUBLIC_SITE_URL=https://your-domain.com
# WARNING: placeholder pub-000... / ca-pub-XXXXXXXXXXXXXXXX blocks AdSense approval.
# Must replace with your real publisher ID from https://www.google.com/adsense/
# Format: ca-pub- + 16 digits. Do NOT deploy/sumbit for review with placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Each slot must be exactly 10 digits (/^\d{10}$/). Placeholder 0000000000 renders
# nothing in production by design — replace with real ad-unit slot IDs after approval.
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=0000000000

# --- AdSense NPA fallback (src/components/AdSlot.tsx) ---
# AdSlot gates pushes on t4s-consent-v1.ad_storage === "granted" by default.
# Optional per-slot opt-in: <AdSlot slot="..." nonPersonalized /> pushes with
# (adsbygoogle).requestNonPersonalizedAds = 1 AFTER an explicit "denied".
# Unknown consent (no choice yet) never pushes — not even NPA (GDPR-safe).
# No env flag needed; default nonPersonalized=false keeps current behavior.
# Reviewer: click "Accept all" to verify personalized; "Reject all" + the
# nonPersonalized prop to verify NPA. Funding Choices remains source of truth.

# --- Readiness check ---
# Run: npm run adsense:check  (node scripts/check-adsense-readiness.mjs)
# Fails on placeholder IDs (ca-pub-XXXX / 0000000000 / pub-0000 in ads.txt),
# missing contact/author/methodology, sitemap gaps, pdf-compress index leaks,
# consent-default/CSP/CookieConsent/Footer/YMYL/metadata/llms.txt regressions.
# Missing vars in local .env are WARN (hosting env may inject them).
