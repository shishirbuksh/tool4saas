NEXT_PUBLIC_SITE_URL=https://your-domain.com
# WARNING: placeholder pub-000... / ca-pub-XXXXXXXXXXXXXXXX blocks AdSense approval.
# Must replace with your real publisher ID from https://www.google.com/adsense/
# Format: ca-pub- + 16 digits. Do NOT deploy/submit for review with placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Monetization uses AdSense Auto Ads (page-level loader in
# src/components/ConsentGatedGoogleScripts.tsx -> AdSenseScript.tsx). No manual
# ad-unit slot IDs are needed; enable Auto Ads in the AdSense dashboard and the
# loader above starts serving once consent is granted. Manual <AdSlot> units were
# removed in favor of Auto Ads.

# --- Google Funding Choices (TCF 2.2) consent message ---
# Message id = the segment after /i/ in the Ad Manager > Privacy & messaging
# snippet, e.g. "pub-6310719489589992". Leave EMPTY until the message actually
# exists in the account (the script 404s + adds latency otherwise). When set,
# src/components/RootDocument.tsx loads it before consent-default.
NEXT_PUBLIC_FUNDING_CHOICES_ID=

# --- Readiness check ---
# Run: npm run adsense:check  (node scripts/check-adsense-readiness.mjs)
# Fails on placeholder IDs (ca-pub-XXXX / pub-0000 in ads.txt), missing
# contact/author/methodology, sitemap gaps, pdf-compress index leaks,
# consent-default/CSP/CookieConsent/Footer/YMYL/metadata/llms.txt regressions.
# Missing vars in local .env are WARN (hosting env may inject them).
