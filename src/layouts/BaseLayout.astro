---
import { Font } from "astro:assets";
import "@/styles/globals.css";
import { siteConfig } from "@/lib/site";
import {
  DEFAULT_ROBOTS,
  googleBotContent,
  resolveTitle,
  robotsContent,
  type PageMeta,
} from "@/lib/seo";
import type { Locale } from "@/lib/i18n-core";

interface Props {
  meta?: PageMeta;
  locale?: Locale;
  pathname?: string;
  css?: string;
  ids?: string[];
  jsonLd?: unknown[];
}

const {
  meta = {},
  locale = "en",
  pathname = "/",
  css = "",
  ids = [],
  jsonLd = [],
} = Astro.props;

const title = resolveTitle(meta);
const og = meta.openGraph;
const description = meta.description ?? og?.description ?? siteConfig.description;
const canonical = meta.alternates?.canonical ?? siteConfig.url;
const languages = meta.alternates?.languages ?? {};
const robots = meta.robots ?? DEFAULT_ROBOTS;
const twitter = meta.twitter;
const ogImages = og?.images ?? [];
const verification = meta.verification;
const graphs = jsonLd.filter(Boolean);

const skipLabel = locale === "es" ? "Saltar al contenido" : locale === "fr" ? "Aller au contenu" : "Skip to content";

const themeScript = `try{var m=localStorage.getItem('color-mode');if(m!=='light'&&m!=='dark')m=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',m==='dark'?'expo-dark':'expo-light');document.documentElement.style.colorScheme=m;var c=m==='dark'?'#0b0b0c':'#ffffff';var q=document.querySelector('meta[name="theme-color"]');if(q)q.setAttribute('content',c);else{var t=document.createElement('meta');t.name='theme-color';t.content=c;document.head.appendChild(t);}}catch(e){}`;

const consentDefault = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });`;

const fundingChoicesBootstrap = `(function(){function s(){if(!window.frames['googlefcPresent']){if(document.body){var i=document.createElement('iframe');i.style='width:0;height:0;border:none;z-index:-1000;left:-1000px;top:-1000px;';i.style.display='none';i.name='googlefcPresent';document.body.appendChild(i);}else{setTimeout(s,0);}}}s();})();`;

const jsonLdScripts = graphs.map((graph) => JSON.stringify(graph).replace(/</g, "\\u003c"));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="application-name" content={meta.applicationName ?? siteConfig.name} />
    <meta name="author" content={meta.authors?.[0]?.name ?? siteConfig.author} />
    <meta name="creator" content={meta.creator ?? siteConfig.author} />
    <meta name="robots" content={robotsContent(robots)} />
    <meta name="googlebot" content={googleBotContent(robots)} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={meta.appleWebApp?.title ?? siteConfig.name} />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content={meta.appleWebApp?.statusBarStyle ?? "default"}
    />

    {og && (
      <>
        <meta property="og:type" content={og.type ?? "website"} />
        {og.locale && <meta property="og:locale" content={og.locale} />}
        {og.alternateLocale?.map((alt) => (
          <meta property="og:locale:alternate" content={alt} />
        ))}
        <meta property="og:url" content={og.url ?? canonical} />
        <meta property="og:site_name" content={og.siteName ?? siteConfig.name} />
        <meta property="og:title" content={og.title ?? title} />
        {og.description && <meta property="og:description" content={og.description} />}
        {ogImages.map((image) => (
          <>
            <meta property="og:image" content={image.url} />
            {image.width && <meta property="og:image:width" content={String(image.width)} />}
            {image.height && <meta property="og:image:height" content={String(image.height)} />}
            {image.alt && <meta property="og:image:alt" content={image.alt} />}
          </>
        ))}
        {og.publishedTime && <meta property="article:published_time" content={og.publishedTime} />}
        {og.modifiedTime && <meta property="article:modified_time" content={og.modifiedTime} />}
        {og.authors?.map((author) => <meta property="article:author" content={author} />)}
      </>
    )}

    {twitter && (
      <>
        <meta name="twitter:card" content={twitter.card ?? "summary_large_image"} />
        <meta name="twitter:title" content={twitter.title ?? title} />
        {twitter.description && <meta name="twitter:description" content={twitter.description} />}
        {twitter.images?.map((image) => <meta name="twitter:image" content={image} />)}
      </>
    )}

    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" type="image/png" />
    <link rel="manifest" href={meta.manifest ?? "/manifest.webmanifest"} />
    <link rel="canonical" href={canonical} />
    {Object.entries(languages).map(([hreflang, href]) => (
      href && <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    {locale === "en" && (
      <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Blog`} href="/rss.xml" />
    )}
    {verification?.google && <meta name="google-site-verification" content={verification.google} />}
    {verification?.other &&
      Object.entries(verification.other).map(([name, value]) => (
        <meta name={name} content={value} />
      ))}

    <script is:inline set:html={themeScript} />
    <script is:inline set:html={consentDefault} />
    {siteConfig.fundingChoicesId && (
      <>
        <script
          is:inline
          src={`https://fundingchoicesmessages.google.com/i/${siteConfig.fundingChoicesId}?ers=1`}
          crossorigin="anonymous"
        />
        <script is:inline set:html={fundingChoicesBootstrap} />
      </>
    )}
    {jsonLdScripts.map((json) => (
      <script type="application/ld+json" set:html={json} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">{skipLabel}</a>
    <slot />
    <script>
      import { hydrateApp } from "@/lib/astro/hydrate";
      let hydrated = false;
      function hydrate() {
        if (hydrated) return;
        hydrated = true;
        hydrateApp();
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(hydrate, { timeout: 1500 });
      } else {
        setTimeout(hydrate, 50);
      }
      window.addEventListener("pointerdown", hydrate, { once: true, passive: true });
      window.addEventListener("keydown", hydrate, { once: true, passive: true });
    </script>
  </body>
</html>
