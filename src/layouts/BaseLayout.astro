---
import { Font } from "astro:assets";
import "@/styles/globals.css";
import { siteConfig } from "@/lib/site";
import type { PageMeta } from "@/lib/seo";
import SEO from "@/components/SEO.astro";

interface Props {
  meta?: PageMeta;
  pathname?: string;
  css?: string;
  ids?: string[];
  jsonLd?: unknown[];
}

const {
  meta = {},
  pathname = "/",
  jsonLd = [],
} = Astro.props;

const skipLabel = "Skip to content";

const themeScript = `try{var m=localStorage.getItem('color-mode');if(m!=='light'&&m!=='dark')m=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',m==='dark'?'expo-dark':'expo-light');document.documentElement.style.colorScheme=m;var c=m==='dark'?'#0b0b0c':'#ffffff';var q=document.querySelector('meta[name="theme-color"]');if(q)q.setAttribute('content',c);else{var t=document.createElement('meta');t.name='theme-color';t.content=c;document.head.appendChild(t);}}catch(e){}`;

const consentDefault = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });`;

const fundingChoicesBootstrap = `(function(){function s(){if(!window.frames['googlefcPresent']){if(document.body){var i=document.createElement('iframe');i.style='width:0;height:0;border:none;z-index:-1000;left:-1000px;top:-1000px;';i.style.display='none';i.name='googlefcPresent';document.body.appendChild(i);}else{setTimeout(s,0);}}}s();})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />

    <!-- Unified SEO: title, description, canonical, robots, OG, Twitter & JSON-LD -->
    <SEO meta={meta} pathname={pathname} jsonLd={jsonLd} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" type="image/png" />
    <link rel="manifest" href={meta.manifest ?? "/manifest.webmanifest"} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Blog`} href="/rss.xml" />

    <script is:inline set:html={themeScript} />
    <script is:inline set:html={consentDefault} />
    {siteConfig.fundingChoicesId && (
      <>
        <script
          is:inline
          src={`https://fundingchoicesmessages.google.com/i/${siteConfig.fundingChoicesId}?ers=1`}
          crossorigin="anonymous"
        />
        <script is:inline set:html={fundingChoicesBootstrap} />
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">{skipLabel}</a>
    <slot />
    <script>
      import { initShell } from "@/lib/shell";

      // Header, search, theme toggle, cookie consent and the consent-gated
      // Google scripts are all plain DOM code, so content pages ship no React.
      initShell();
    </script>
  </body>
</html>
