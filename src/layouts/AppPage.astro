---
import { createElement, type ComponentType } from "react";
import BaseLayout from "./BaseLayout.astro";
import AppShell from "@/components/AppShell";
import { renderReactPage } from "@/lib/astro/render";
import { siteJsonLd } from "@/lib/seo/jsonld";
import type { PageMeta } from "@/lib/seo";

interface Props {
  View: ComponentType<any>;
  viewKey: string;
  props?: Record<string, unknown>;
  meta?: PageMeta;
  pathname?: string;
  jsonLd?: unknown[];
  /**
   * Hydrate the view with React. Only interactive views need this; static
   * content pages ship no React at all (the shell is vanilla JS).
   */
  hydrate?: boolean;
}

const {
  View,
  viewKey,
  props = {},
  meta = {},
  pathname = "/",
  jsonLd = [],
  hydrate = false,
} = Astro.props;

// The whole document body (shell + view) is rendered to static HTML here. The
// `#app` subtree is the only part React may later hydrate.
const { html, css, ids } = renderReactPage(
  createElement(AppShell, { pathname, viewKey, hydrate }, createElement(View, props)),
);

// Serialized once for hydration. `<` is escaped so a string in tool copy can
// never terminate the JSON script tag early.
const propsJson = JSON.stringify(props).replace(/</g, "\\u003c");
const isHome = pathname === "/";
---

<BaseLayout
  meta={meta}
  pathname={pathname}
  css={css}
  ids={ids}
  jsonLd={isHome ? [siteJsonLd(), ...jsonLd] : jsonLd}
>
  <script type="application/json" id="app-props" set:html={propsJson} />
  <Fragment set:html={html} />
</BaseLayout>
