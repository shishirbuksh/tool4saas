---
import AppPage from "@/layouts/AppPage.astro";
import MethodologyView from "@/views/pages/methodology";
import { staticPageMetadata } from "@/lib/metadata";
import { methodologyJsonLd } from "@/lib/seo/jsonld";

const meta = staticPageMetadata({
  title: "How We Test Tools — Accuracy You Can Verify",
  description:
    "How Tool4SaaS tests every tool: built locally, verified against known samples, checked across browsers, and kept up to date.",
  path: "/methodology",
});
---

<AppPage
  View={MethodologyView}
  viewKey="pages/methodology"
  props={{}}
  meta={meta}
  pathname="/methodology"
jsonLd={[methodologyJsonLd()]} />
