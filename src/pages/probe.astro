---
import { createElement } from "react";
import Probe from "@/components/Probe";
import { renderReactPage } from "@/lib/astro/render";

const { html, css, ids } = renderReactPage(createElement(Probe));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Probe</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://tool4saas.com/probe" />
    {ids.length > 0 && <style data-emotion={`css ${ids.join(" ")}`} set:html={css} />}
  </head>
  <body>
    <div id="probe" set:html={html} />
  </body>
</html>
