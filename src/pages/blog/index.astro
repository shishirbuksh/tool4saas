---
import AppPage from "@/layouts/AppPage.astro";
import BlogIndexView from "@/views/pages/blog-index";
import { staticPageMetadata } from "@/lib/metadata";
import { blogIndexJsonLd } from "@/lib/seo/jsonld";

import { BLOG_PILLARS, getPillarPost, getClustersForPillar } from "@/lib/blog-registry";
import { isNoindexCluster } from "@/lib/blog/noindex";
import { countWords } from "@/lib/blog";

const meta = staticPageMetadata({
  title: "Blog — Free Tool Guides & Tutorials",
  description:
    "Practical guides for every Tool4SaaS tool: invoice generators, PDF tools, calculators and more. Pillar guides + step-by-step tutorials with free templates.",
  path: "/blog",
});

const sections = BLOG_PILLARS.map((p) => {
  const pillar = getPillarPost(p.pillar);
  const clusters = getClustersForPillar(p.pillar).filter((c) => !isNoindexCluster(c.pillar, c.slug));
  const words = pillar ? countWords(pillar.html) : 0;
  return {
    meta: p,
    words,
    clusters: clusters.map((c) => ({ slug: c.slug, pillar: c.pillar, title: c.title })),
  };
});
---

<AppPage
  View={BlogIndexView}
  viewKey="pages/blog-index"
  props={{ sections }}
  meta={meta}
  pathname="/blog"
  jsonLd={[blogIndexJsonLd()]}
/>
