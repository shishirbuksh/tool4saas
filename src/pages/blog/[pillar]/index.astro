---
import AppPage from "@/layouts/AppPage.astro";
import BlogPillarView from "@/views/pages/blog-pillar";
import { BLOG_PILLARS, getPillarPost } from "@/lib/blog-registry";
import { blogMetadataFor } from "@/components/blog/BlogArticle";

export function getStaticPaths() {
  return BLOG_PILLARS.map((p) => ({ params: { pillar: p.pillar } }));
}

import { getClustersForPillar, getRelatedPosts } from "@/lib/blog-registry";
import { isNoindexCluster } from "@/lib/blog/noindex";

const pillar = Astro.params.pillar!;
const post = getPillarPost(pillar);
if (!post) {
  return Astro.redirect("/404");
}
const clusters = getClustersForPillar(pillar).filter((c) => !isNoindexCluster(c.pillar, c.slug));
const related = getRelatedPosts(post, 4);

const meta = blogMetadataFor(post);
---

<AppPage
  View={BlogPillarView}
  viewKey="pages/blog-pillar"
  props={{ pillar, post, clusters, related }}
  meta={meta}
  locale="en"
  pathname={`/blog/${pillar}`}
/>
