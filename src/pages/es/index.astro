---
import AppPage from "@/layouts/AppPage.astro";
import EsHomeView from "@/views/pages/es-home";
import { siteConfig } from "@/lib/site";
import { hreflangHubLanguages } from "@/lib/i18n";
import type { PageMeta } from "@/lib/seo";

const base = siteConfig.url.replace(/\/$/, "");
const title = "Herramientas Gratis Online – Sin Registro (2026) | Tool4SaaS";
const description =
  "Herramientas gratis en español: facturas, QR, tarjetas y unidades. Sin registro, privadas en tu navegador — prueba gratis.";

const meta: PageMeta = {
  title: { absolute: title },
  description,
  alternates: {
    canonical: `${base}/es`,
    languages: hreflangHubLanguages(base, "es"),
  },
  robots: { index: true, follow: true },
  openGraph: {
    type: "website",
    locale: "es_ES",
    alternateLocale: ["en_US", "fr_FR"],
    url: `${base}/es`,
    siteName: siteConfig.name,
    title,
    description,
    images: [{ url: `${base}/og/home`, width: 1200, height: 630, alt: siteConfig.name }],
  },
  twitter: {
    card: "summary_large_image",
    title,
    description,
    images: [`${base}/og/home`],
  },
};
---

<AppPage
  View={EsHomeView}
  viewKey="pages/es-home"
  props={{}}
  meta={meta}
  locale="es"
  pathname="/es"
/>
