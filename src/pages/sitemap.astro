---
import AppPage from "@/layouts/AppPage.astro";
import SitemapView, { type SitemapViewProps } from "@/views/pages/sitemap";
import { staticPageMetadata } from "@/lib/metadata";
import { toolsByCategoryCached } from "@/lib/tools";
import { NOINDEX_SLUGS } from "@/lib/tools/noindex";
import { BLOG_PILLARS, getClustersForPillar } from "@/lib/blog-registry";
import { isNoindexCluster } from "@/lib/blog/noindex";
import { pilotSlugsForLocale } from "@/lib/i18n-core";
import { getLocaleTool } from "@/lib/i18n";
import { VISIBLE_TOOL_COUNT } from "@/lib/tools/counts";

// Assemble categories and indexed tools
const groups = toolsByCategoryCached();
const categoriesData = groups.map((g) => {
  const visibleTools = g.tools
    .filter((t) => !NOINDEX_SLUGS.has(t.slug))
    .map((t) => ({
      slug: t.slug,
      title: t.title,
      short: t.short,
      category: t.category,
    }));
  return {
    id: g.category.id,
    label: g.category.label,
    description: g.category.description,
    count: visibleTools.length,
    tools: visibleTools,
  };
});

// Assemble blog pillars and clusters
const pillarsData = BLOG_PILLARS.map((p) => {
  const clusters = getClustersForPillar(p.pillar)
    .filter((c) => !isNoindexCluster(c.pillar, c.slug))
    .map((c) => ({
      slug: c.slug,
      title: c.title,
      readingMinutes: c.readingMinutes,
    }));
  return {
    pillar: p.pillar,
    title: p.title,
    shortLabel: p.shortLabel,
    description: p.description,
    toolSlug: p.toolSlug,
    clusters,
  };
});

// Assemble Spanish pilots
const esSlugs = [...pilotSlugsForLocale("es")];
const pilotsEs = esSlugs.map((slug) => {
  const t = getLocaleTool("es", slug);
  return {
    slug,
    title: t ? t.title : slug,
    locale: "es" as const,
    path: `/es/${slug}`,
  };
});

// Assemble French pilots
const frSlugs = [...pilotSlugsForLocale("fr")];
const pilotsFr = frSlugs.map((slug) => {
  const t = getLocaleTool("fr", slug);
  return {
    slug,
    title: t ? t.title : slug,
    locale: "fr" as const,
    path: `/fr/${slug}`,
  };
});

const totalGuidesCount = pillarsData.reduce((acc, p) => acc + p.clusters.length + 1, 0);

const sitemapProps: SitemapViewProps = {
  categories: categoriesData,
  pillars: pillarsData,
  pilotsEs,
  pilotsFr,
  totalTools: VISIBLE_TOOL_COUNT,
  totalGuides: totalGuidesCount,
  totalPilots: pilotsEs.length + pilotsFr.length,
};

const meta = staticPageMetadata({
  title: "HTML Sitemap — All Tools, Guides & Pages",
  description:
    "Complete directory of all 125 free online tools, 198 guides, multilingual pilots and company resources on Tool4SaaS.",
  path: "/sitemap",
});
---

<AppPage
  View={SitemapView}
  viewKey="pages/sitemap"
  props={sitemapProps}
  meta={meta}
  locale="en"
  pathname="/sitemap"
/>
