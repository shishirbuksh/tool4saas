---
import { siteConfig } from "@/lib/site";
import {
  DEFAULT_ROBOTS,
  googleBotContent,
  resolveTitle,
  robotsContent,
  type PageMeta,
} from "@/lib/seo";
import { fitMetaTitle, fitMetaDescription } from "@/lib/seo-title";
import type { Locale } from "@/lib/i18n-core";

interface Props {
  meta?: PageMeta;
  locale?: Locale;
  pathname?: string;
  jsonLd?: unknown[];
}

const {
  meta = {},
  locale = "en",
  pathname = "/",
  jsonLd = [],
} = Astro.props;

const isSpecial = pathname === "/404" || pathname === "/probe";
const rawTitle = resolveTitle(meta);
const title = isSpecial
  ? rawTitle
  : fitMetaTitle(rawTitle.replace(/\s*\|\s*Tool4SaaS$/, "").replace(/\s*—\s*Tool4SaaS.*$/, "").trim());

const og = meta.openGraph;
const rawDescription = meta.description ?? og?.description ?? siteConfig.description;
const description = isSpecial ? rawDescription : fitMetaDescription(rawDescription);

const canonical = meta.alternates?.canonical ?? (pathname === "/" ? siteConfig.url : `${siteConfig.url.replace(/\/$/, "")}${pathname}`);
const languages = meta.alternates?.languages ?? {};
const robots = meta.robots ?? DEFAULT_ROBOTS;
const twitter = meta.twitter;
const ogImages = og?.images ?? [];
const verification = meta.verification;
const graphs = jsonLd.filter(Boolean);

// Hreflang rules (Google Search Central):
// Emit self-referencing hreflang (en, es, fr + x-default) ONLY when a translation actually exists.
// Single-language pages (e.g. tools with no ES/FR pilots) must NOT declare alternate clusters.
const rawHreflangs = Object.entries(languages).filter(([_, href]) => Boolean(href));
const hasTranslation = rawHreflangs.some(([lang]) => lang !== "en" && lang !== "x-default");
const hreflangEntries = hasTranslation ? rawHreflangs : [];

// Available alternate locales for Open Graph:
const currentOgLocale = og?.locale ?? (locale === "es" ? "es_ES" : locale === "fr" ? "fr_FR" : "en_US");
let alternateOgLocales: string[] = [];

if (hasTranslation) {
  const availableLocales = new Set<string>();
  for (const [lang] of hreflangEntries) {
    if (lang === "en" || lang === "x-default") availableLocales.add("en_US");
    else if (lang === "es") availableLocales.add("es_ES");
    else if (lang === "fr") availableLocales.add("fr_FR");
  }
  availableLocales.delete(currentOgLocale);
  alternateOgLocales = Array.from(availableLocales);
} else if (og?.alternateLocale && og.alternateLocale.length > 0) {
  alternateOgLocales = og.alternateLocale.filter((alt) => alt !== currentOgLocale);
}

const jsonLdScripts = graphs.map((graph) =>
  JSON.stringify(graph).replace(/</g, "\\u003c")
);
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="application-name" content={meta.applicationName ?? siteConfig.name} />
<meta name="author" content={meta.authors?.[0]?.name ?? siteConfig.author} />
<meta name="creator" content={meta.creator ?? siteConfig.author} />
<meta name="robots" content={robotsContent(robots)} />
<meta name="googlebot" content={googleBotContent(robots)} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content={meta.appleWebApp?.title ?? siteConfig.name} />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content={meta.appleWebApp?.statusBarStyle ?? "default"}
/>

<link rel="canonical" href={canonical} />

{hreflangEntries.map(([hreflang, href]) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}

{og && (
  <>
    <meta property="og:type" content={og.type ?? "website"} />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map((alt) => (
      <meta property="og:locale:alternate" content={alt} />
    ))}
    <meta property="og:url" content={og.url ?? canonical} />
    <meta property="og:site_name" content={og.siteName ?? siteConfig.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImages.map((image) => (
      <>
        <meta property="og:image" content={image.url} />
        {image.width && <meta property="og:image:width" content={String(image.width)} />}
        {image.height && <meta property="og:image:height" content={String(image.height)} />}
        {image.alt && <meta property="og:image:alt" content={image.alt} />}
      </>
    ))}
    {og.publishedTime && <meta property="article:published_time" content={og.publishedTime} />}
    {og.modifiedTime && <meta property="article:modified_time" content={og.modifiedTime} />}
    {og.authors?.map((author) => <meta property="article:author" content={author} />)}
  </>
)}

{twitter && (
  <>
    <meta name="twitter:card" content={twitter.card ?? "summary_large_image"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {twitter.images?.map((image) => <meta name="twitter:image" content={image} />)}
  </>
)}

{verification?.google && <meta name="google-site-verification" content={verification.google} />}
{verification?.other &&
  Object.entries(verification.other).map(([name, value]) => (
    <meta name={name} content={value} />
  ))}

{jsonLdScripts.map((json) => (
  <script type="application/ld+json" set:html={json} />
))}
