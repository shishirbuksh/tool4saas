---
/**
 * Single source of truth for <head> SEO tags.
 *
 * Delegates tag generation to `astro-seo` (canonical, robots, Open Graph,
 * Twitter, hreflang) and keeps only the project-specific logic here:
 *   - title/description fitting (src/lib/seo-title.ts)
 *   - PageMeta -> astro-seo prop mapping
 *   - googlebot + app/author meta that astro-seo does not emit
 *   - JSON-LD blocks (astro-seo intentionally does not render structured data)
 *
 * Rendering is static (SSG), so this runs at build time only.
 */
import { SEO as AstroSEO } from "astro-seo";
import { siteConfig } from "@/lib/site";
import {
  DEFAULT_ROBOTS,
  googleBotContent,
  resolveTitle,
  type PageMeta,
} from "@/lib/seo";
import { fitMetaTitle, fitMetaDescription } from "@/lib/seo-title";

interface Props {
  meta?: PageMeta;
  pathname?: string;
  jsonLd?: unknown[];
}

const { meta = {}, pathname = "/", jsonLd = [] } = Astro.props;

const base = siteConfig.url.replace(/\/$/, "");

// --- title ---------------------------------------------------------------
const isSpecial = pathname === "/404" || pathname === "/probe";
const isHome = pathname === "/";
const rawTitle = resolveTitle(meta);
const isExplicitAbsolute =
  typeof meta.title === "object" && Boolean(meta.title.absolute);

const title =
  isSpecial || isExplicitAbsolute || isHome
    ? rawTitle
    : fitMetaTitle(
        rawTitle
          .replace(/\s*\|\s*Tool4SaaS$/, "")
          .replace(/\s*—\s*Tool4SaaS.*$/, "")
          .trim(),
      );

// --- description ---------------------------------------------------------
const og = meta.openGraph;
const rawDescription =
  meta.description ?? og?.description ?? siteConfig.description;
const description =
  isSpecial || Boolean(meta.description)
    ? rawDescription
    : fitMetaDescription(rawDescription);

// --- canonical + robots --------------------------------------------------
const canonical =
  meta.alternates?.canonical ?? (isHome ? siteConfig.url : `${base}${pathname}`);
const robots = meta.robots ?? DEFAULT_ROBOTS;
const g = robots.googleBot ?? {};
const robotsExtras = [
  `max-video-preview:${g["max-video-preview"] ?? -1}`,
  `max-image-preview:${g["max-image-preview"] ?? "large"}`,
  `max-snippet:${g["max-snippet"] ?? -1}`,
].join(", ");

// --- Open Graph ----------------------------------------------------------
const ogImages = og?.images ?? [];
const primaryImage = ogImages[0];
const fallbackImage = `${base}/og/home.png`;

const openGraph = og
  ? {
      basic: {
        title: og.title ?? title,
        type: og.type ?? "website",
        image: primaryImage?.url ?? fallbackImage,
        url: og.url ?? canonical,
      },
      optional: {
        description,
        locale: og.locale ?? siteConfig.locale,
        localeAlternate: og.alternateLocale,
        siteName: og.siteName ?? siteConfig.name,
      },
      image: {
        width: primaryImage?.width,
        height: primaryImage?.height,
        alt: primaryImage?.alt ?? siteConfig.name,
      },
      article:
        og.publishedTime || og.modifiedTime || og.authors?.length
          ? {
              publishedTime: og.publishedTime,
              modifiedTime: og.modifiedTime,
              authors: og.authors,
            }
          : undefined,
    }
  : undefined;

// --- Twitter -------------------------------------------------------------
const twitter = meta.twitter
  ? {
      card: (meta.twitter.card ?? "summary_large_image") as
        | "summary"
        | "summary_large_image"
        | "app"
        | "player",
      title: meta.twitter.title ?? title,
      description: meta.twitter.description ?? description,
      image: meta.twitter.images?.[0],
      imageAlt: primaryImage?.alt ?? siteConfig.name,
    }
  : undefined;

// --- tags astro-seo does not emit ---------------------------------------
const extraMeta = [
  { name: "application-name", content: meta.applicationName ?? siteConfig.name },
  { name: "author", content: meta.authors?.[0]?.name ?? siteConfig.author },
  { name: "creator", content: meta.creator ?? siteConfig.author },
  { name: "googlebot", content: googleBotContent(robots) },
  { name: "mobile-web-app-capable", content: "yes" },
  {
    name: "apple-mobile-web-app-title",
    content: meta.appleWebApp?.title ?? siteConfig.name,
  },
  {
    name: "apple-mobile-web-app-status-bar-style",
    content: meta.appleWebApp?.statusBarStyle ?? "default",
  },
  ...(meta.verification?.google
    ? [{ name: "google-site-verification", content: meta.verification.google }]
    : []),
  ...Object.entries(meta.verification?.other ?? {}).map(([name, content]) => ({
    name,
    content,
  })),
];

// --- hreflang (self-referencing; builders already emit en + x-default) ---
const languageAlternates = meta.alternates?.languages
  ? Object.entries(meta.alternates.languages)
      .filter((entry): entry is [string, string] => Boolean(entry[1]))
      .map(([hrefLang, href]) => ({ hrefLang, href }))
  : undefined;

const jsonLdScripts = jsonLd
  .filter(Boolean)
  .map((graph) => JSON.stringify(graph).replace(/</g, "\\u003c"));
---

<AstroSEO
  title={title}
  description={description}
  canonical={isSpecial ? null : canonical}
  noindex={!robots.index}
  nofollow={!robots.follow}
  robotsExtras={robotsExtras}
  languageAlternates={languageAlternates}
  openGraph={openGraph}
  twitter={twitter}
  extend={{ meta: extraMeta }}
  removeTrailingSlashForRoot
/>

{jsonLdScripts.map((json) => <script type="application/ld+json" set:html={json} />)}
